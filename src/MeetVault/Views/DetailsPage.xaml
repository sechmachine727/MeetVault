<Page
    x:Class="MeetVault.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Details" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock x:Name="MeetingTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MeetingMeta" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Copy transcript" Click="Copy_Click"
                    AutomationProperties.Name="Copy transcript"
                    ToolTipService.ToolTip="Copy the transcript to the clipboard" />
            <Button Content="Export to Documents" Click="Export_Click"
                    AutomationProperties.Name="Export transcript to Documents"
                    ToolTipService.ToolTip="Write the transcript to a text file in Documents" />
            <Button x:Name="SendButton" Content="Send to Gemini" Click="Gemini_Click"
                    AutomationProperties.Name="Send to Gemini"
                    ToolTipService.ToolTip="Run the Gemini job against the demo transport" />
        </StackPanel>

        <Expander x:Name="GeminiExpander" Grid.Row="4" Header="Gemini job" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock x:Name="JobState" Text="No job sent yet." TextWrapping="Wrap" />
                <TextBlock x:Name="JobResult" Text="" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </Expander>

        <Grid Grid.Row="5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Transcript" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="LineStatus" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="6">
            <ItemsControl x:Name="TranscriptList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Width="160" HorizontalAlignment="Stretch"
                                      Loaded="SpeakerPicker_Loaded"
                                      SelectionChanged="SpeakerPicker_SelectionChanged"
                                      AutomationProperties.Name="Speaker"
                                      ToolTipService.ToolTip="Reassign this line to another speaker" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="LineText_TextChanged"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     AutomationProperties.Name="Transcript line"
                                     ToolTipService.ToolTip="Edit this line" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyState" Text="Nothing to show yet. Start a meeting to populate this transcript."
                       Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                       MaxWidth="320" TextAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
