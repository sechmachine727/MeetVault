<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="0" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="Good evening" Opacity="0.7" />
            <TextBlock x:Name="GreetingTitle" Text="Ready to capture" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock x:Name="ModelStatus" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" Margin="0,0,0,12" />
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" Title="Unfinished meeting found" IsClosable="True" Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <Button Content="Resume in Live" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Readiness strip: three facts + one primary action, no cards. -->
            <Grid ColumnSpacing="24" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <TextBlock x:Name="MicStatus" Text="Not started" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="App source" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceStatus" Text="Not picked" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Engine" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineStatus" Text="Checking..." Opacity="0.7" />
                </StackPanel>
                <Button Grid.Column="3" Content="Start new meeting" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Start new meeting" />
            </Grid>
            <TextBlock Text="Recent meetings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,4" ColumnSpacing="16" Opacity="0.7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Title" FontSize="12" />
                <TextBlock Grid.Column="1" Text="When" FontSize="12" />
                <TextBlock Grid.Column="2" Text="Duration" FontSize="12" />
                <TextBlock Grid.Column="3" Text="Status" FontSize="12" />
            </Grid>
            <ListView x:Name="RecentMeetings" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" Spacing="8" Margin="0,24" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="No meetings yet" FontWeight="SemiBold" />
                <TextBlock Text="Start your first meeting and the transcript lands here with speakers, timing, and Gemini summaries." Opacity="0.7" TextWrapping="Wrap" />
                <Button Content="Start new meeting" Click="Start_Click" HorizontalAlignment="Left" AutomationProperties.Name="Start new meeting" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
