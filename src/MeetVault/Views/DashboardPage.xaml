<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" Title="Unfinished meeting found" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Resume in Live" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Quick start" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Spacing="4">
                <TextBlock Text="Microphone: not started" TextWrapping="Wrap" />
                <TextBlock Text="Screen source: not picked" TextWrapping="Wrap" />
                <TextBlock x:Name="ModelStatus" Text="Speech model: checking..." TextWrapping="Wrap" />
            </StackPanel>
            <Button Content="Start new meeting" Click="Start_Click" HorizontalAlignment="Left" />

            <TextBlock Text="Recent meetings" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="RecentMeetings" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,8" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding When}" Opacity="0.7" />
                            <TextBlock Text="{Binding Duration}" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No meetings yet. Start one to populate this list." Visibility="Collapsed" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>

