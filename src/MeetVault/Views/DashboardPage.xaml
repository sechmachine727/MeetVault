<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24" Spacing="0" HorizontalAlignment="Stretch">
            <TextBlock x:Name="GreetingTitle" Text="Ready to capture" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBlock x:Name="ModelStatus" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" Margin="0,0,0,12" />
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" Title="Unfinished meeting found" IsClosable="True" Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <Button Content="Resume in Live" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- Readiness: wraps to two lines on narrow windows; action never clips. -->
            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="220" Margin="0,0,0,8">
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <TextBlock x:Name="MicStatus" Text="Not started" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="App source" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceStatus" Text="Not picked" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Engine" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineStatus" Text="Checking..." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="Start new meeting" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top" Margin="0,0,0,12" AutomationProperties.Name="Start new meeting" />
            </VariableSizedWrapGrid>
            <TextBlock Text="Recent meetings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,8" />
            <!-- Header shares the row template metrics so columns align at any width. -->
            <Grid Padding="0,0,0,4" ColumnSpacing="16" Opacity="0.7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Title" FontSize="12" />
                <TextBlock Grid.Column="1" Text="When" FontSize="12" />
                <TextBlock Grid.Column="2" Text="Duration" FontSize="12" MinWidth="90" />
                <TextBlock Grid.Column="3" Text="Status" FontSize="12" MinWidth="80" />
            </Grid>
            <ItemsControl x:Name="RecentMeetings">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" MinWidth="90" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" MinWidth="80" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="EmptyState" Spacing="8" Margin="0,24" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="No meetings yet" FontWeight="SemiBold" />
                <TextBlock Text="Start your first meeting and the transcript lands here with speakers, timing, and Gemini summaries." Opacity="0.7" TextWrapping="Wrap" />
                <Button Content="Start new meeting" Click="Start_Click" HorizontalAlignment="Left" AutomationProperties.Name="Start new meeting" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
