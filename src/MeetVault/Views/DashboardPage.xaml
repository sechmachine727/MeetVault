<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="1100">
            <!-- Greeting on the left, the primary action top-right where it stays reachable. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingTitle" Text="Ready to capture" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelStatus" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Start new meeting" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" AutomationProperties.Name="Start new meeting" />
            </Grid>
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" Title="Unfinished meeting found" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Resume in Live" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="220">
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <TextBlock x:Name="MicStatus" Text="Not started" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Engine" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineStatus" Text="Checking..." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </VariableSizedWrapGrid>
            <TextBlock Text="Recent meetings" Style="{StaticResource SubtitleTextBlockStyle}" />
            <!-- Card container keeps the table visually distinct from the page. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12,6">
                <StackPanel>
                    <Grid Padding="12,0,12,4" ColumnSpacing="16" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Title" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="When" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Duration" FontSize="12" MinWidth="90" />
                        <TextBlock Grid.Column="3" Text="Status" FontSize="12" MinWidth="80" />
                    </Grid>
                    <ItemsControl x:Name="RecentMeetings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenMeeting_Click" Background="Transparent" BorderThickness="0" Padding="12,10"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="4"
                                        AutomationProperties.Name="{Binding Title}"
                                        ToolTipService.ToolTip="Select a meeting to open its details">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" MinWidth="90" />
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" MinWidth="80" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Spacing="8" Margin="12,16" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="No meetings yet" FontWeight="SemiBold" />
                        <TextBlock Text="Start your first meeting and the transcript lands here with speakers, timing, and Gemini summaries." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

