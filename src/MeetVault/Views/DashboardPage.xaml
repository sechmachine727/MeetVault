<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="1100">
            <!-- Greeting on the left, the primary action top-right where it stays reachable. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingTitle" Text="Ready to capture" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelStatus" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Start new meeting" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" AutomationProperties.Name="Start new meeting" />
            </Grid>
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="RecoveryBar" IsOpen="False" Severity="Warning" Title="Unfinished meeting found" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button Content="Resume in Live" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="220">
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Microphone" FontWeight="SemiBold" />
                    <TextBlock x:Name="MicStatus" Text="Not started" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock Text="Engine" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineStatus" Text="Checking..." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </VariableSizedWrapGrid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Recent meetings" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="Manage meetings"
                        AutomationProperties.Name="Manage meetings">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Delete meetings" Click="EnterSelection_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Card container keeps the table visually distinct from the page. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12,6">
                <StackPanel>
                    <StackPanel x:Name="SelectionBar" Orientation="Horizontal" Spacing="8" Padding="12,6,12,2" Visibility="Collapsed">
                        <TextBlock x:Name="SelectionCount" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="SelectAllButton" Content="Select all visible" Click="SelectAll_Click" />
                        <Button x:Name="ClearSelectionButton" Content="Clear selection" Click="ClearSelection_Click" />
                        <Button x:Name="DeleteSelectedButton" Content="Delete selected" Click="DeleteSelected_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelSelectionButton" Content="Cancel" Click="CancelSelection_Click" />
                    </StackPanel>
                    <Grid Padding="12,0,12,4" ColumnSpacing="16" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderSelectSpacer" Width="32" Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" Text="Title" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="When" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Duration" FontSize="12" MinWidth="90" />
                        <TextBlock Grid.Column="4" Text="Status" FontSize="12" MinWidth="80" />
                    </Grid>
                    <ItemsControl x:Name="RecentMeetings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenMeeting_Click" Background="{Binding RowBackground}" BorderThickness="0" Padding="12,10"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="4"
                                        AutomationProperties.Name="{Binding Title}"
                                        ToolTipService.ToolTip="{Binding RowTooltip}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The checkbox is a visual indicator; the row click toggles
                                             selection (hit testing stays on the row button). -->
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsSelectable}"
                                                  Visibility="{Binding CheckVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                                  MinWidth="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" MinWidth="90" />
                                        <TextBlock Grid.Column="4" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" MinWidth="80" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Spacing="8" Margin="12,16" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="No meetings yet" FontWeight="SemiBold" />
                        <TextBlock Text="Start your first meeting and the transcript lands here with speakers, timing, and Gemini summaries." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
