<Page
    x:Class="MeetVault.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetVault.Views">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />

            <StackPanel Spacing="8">
                <TextBlock x:Uid="SetLangHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock x:Uid="SetLang" FontWeight="SemiBold" />
                        <TextBlock x:Uid="SetLangDesc" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="LanguagePicker" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                              SelectionChanged="Language_SelectionChanged"
                              x:Uid="SetLangPicker" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Microphone" FontWeight="SemiBold" />
                        <TextBlock Text="The device used when the microphone is recorded." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="MicPicker" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                              SelectionChanged="Picker_SelectionChanged"
                              AutomationProperties.Name="Microphone" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Record microphone" FontWeight="SemiBold" />
                        <TextBlock Text="Your own voice. Turn off to capture only system audio." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MicSwitch" Grid.Column="1" HorizontalAlignment="Left" IsOn="True"
                                  Toggled="Audio_Toggled" AutomationProperties.Name="Record microphone" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Record system audio" FontWeight="SemiBold" />
                        <TextBlock Text="What your speakers play, mixed with the microphone." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SystemSwitch" Grid.Column="1" HorizontalAlignment="Left" IsOn="True"
                                  Toggled="Audio_Toggled" AutomationProperties.Name="Record system audio" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="System audio source" FontWeight="SemiBold" />
                        <TextBlock Text="All apps, or one running app such as a conference app." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="SourcePicker" Grid.Column="1" Width="320" HorizontalAlignment="Left"
                              SelectionChanged="Picker_SelectionChanged"
                              AutomationProperties.Name="System audio source" />
                </Grid>
                <TextBlock x:Name="AudioStatus" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Transcription" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Model" FontWeight="SemiBold" />
                        <TextBlock Text="Whisper model file used for local transcription." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ModelPicker" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                              SelectionChanged="Picker_SelectionChanged"
                              AutomationProperties.Name="Transcription model" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Device" FontWeight="SemiBold" />
                        <TextBlock Text="Where inference runs." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="DevicePicker" Grid.Column="1" Width="320" HorizontalAlignment="Left"
                              SelectionChanged="Picker_SelectionChanged"
                              AutomationProperties.Name="Transcription device">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Speaker diarization" FontWeight="SemiBold" />
                        <TextBlock Text="Split the transcript into speaker turns." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="DiarizationSwitch" Grid.Column="1" HorizontalAlignment="Left"
                                  IsOn="True" Toggled="Diarization_Toggled"
                                  AutomationProperties.Name="Speaker diarization" />
                </Grid>
                <TextBlock x:Name="TranscriptionStatus" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Overlay" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="These values apply the next time the overlay window opens." Opacity="0.7" TextWrapping="Wrap" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Keep on top" FontWeight="SemiBold" />
                        <TextBlock Text="Pin the overlay above other windows." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PinSwitch" Grid.Column="1" HorizontalAlignment="Left"
                                  IsOn="True" Toggled="Pin_Toggled"
                                  AutomationProperties.Name="Keep overlay on top" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Opacity" FontWeight="SemiBold" />
                        <TextBlock Text="Overlay background opacity." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                            Minimum="0.3" Maximum="1.0" StepFrequency="0.05" Value="0.9"
                            ValueChanged="Opacity_ValueChanged"
                            AutomationProperties.Name="Overlay opacity" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Font size" FontWeight="SemiBold" />
                        <TextBlock Text="Overlay transcript font, in points." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="FontSizeBox" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                               Minimum="10" Maximum="36" Value="16" SmallChange="1"
                               SpinButtonPlacementMode="Compact" ValueChanged="Number_ValueChanged"
                               AutomationProperties.Name="Overlay font size" />
                </Grid>
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Lines shown" FontWeight="SemiBold" />
                        <TextBlock Text="How many transcript lines the overlay keeps on screen." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox x:Name="LinesBox" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                               Minimum="1" Maximum="10" Value="3" SmallChange="1"
                               SpinButtonPlacementMode="Compact" ValueChanged="Number_ValueChanged"
                               AutomationProperties.Name="Overlay lines shown" />
                </Grid>
                <TextBlock x:Name="OverlayStatus" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Storage" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Location" FontWeight="SemiBold" />
                        <TextBlock Text="Folder where exported transcripts are written." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="StoragePathBox" Grid.Column="1" Width="420" HorizontalAlignment="Left"
                             LostFocus="Refresh_Storage"
                             AutomationProperties.Name="Storage location" />
                </Grid>
                <TextBlock x:Name="StorageStatus" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock x:Name="UsageText" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Logging" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="Log level" FontWeight="SemiBold" />
                        <TextBlock Text="How much the app writes to its log file." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="LogLevelPicker" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="Picker_SelectionChanged"
                              AutomationProperties.Name="Log level" />
                </Grid>
                <TextBlock x:Name="LogStatus" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open log folder" Click="OpenLogFolder_Click" AutomationProperties.Name="Open log folder" />
                    <Button Content="Show log" Click="ShowLog_Click" AutomationProperties.Name="Show log" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Gemini" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Top">
                        <TextBlock Text="API key" FontWeight="SemiBold" />
                        <TextBlock Text="Stored in Windows Credential Locker, never in a plain file." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" Orientation="Horizontal">
                        <PasswordBox x:Name="ApiKeyBox" Width="280" PlaceholderText="Paste the Gemini API key"
                                     AutomationProperties.Name="Gemini API key" />
                        <Button x:Name="SaveKeyButton" Content="Save" Click="SaveKey_Click"
                                AutomationProperties.Name="Save Gemini API key" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="GeminiStatus" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

