<Page
    x:Class="MeetVault.Views.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,24" Spacing="12" HorizontalAlignment="Stretch" MaxWidth="1100">
            <TextBlock Text="Meetings" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search meetings" MinWidth="240" MaxWidth="420" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
            <TextBlock x:Name="EmptyState" Text="No meetings yet. Start one to populate this list." Visibility="Collapsed" TextWrapping="Wrap" />
            <!-- Card container keeps the table visually distinct from the page. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12,6">
                <StackPanel>
                    <Grid Padding="12,0,12,4" ColumnSpacing="16" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Title" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="When" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Duration" FontSize="12" MinWidth="90" />
                        <TextBlock Grid.Column="3" Text="Status" FontSize="12" MinWidth="80" />
                    </Grid>
                    <ItemsControl x:Name="MeetingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Row button and Delete are siblings, not nested: an inner Button
                                     inside another Button never receives the click. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OpenMeeting_Click" Background="Transparent" BorderThickness="0" Padding="12,10"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="4"
                                            AutomationProperties.Name="{Binding Title}"
                                            ToolTipService.ToolTip="Select a meeting to open its details">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" MinWidth="90" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" MinWidth="80" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Content="Delete" Click="DeleteMeeting_Click" VerticalAlignment="Center"
                                            AutomationProperties.Name="Delete"
                                            AutomationProperties.HelpText="{Binding Title}"
                                            ToolTipService.ToolTip="Delete this meeting and its recording" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
