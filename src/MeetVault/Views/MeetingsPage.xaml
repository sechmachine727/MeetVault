<Page
    x:Class="MeetVault.Views.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Meetings" Style="{StaticResource TitleTextBlockStyle}" />
        <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
        <TextBlock Text="Meeting cards with status and duration." TextWrapping="Wrap" />
        <Button Content="Search" Click="Primary_Click" />
        <TextBlock x:Name="EmptyState" Text="Nothing here yet. Start a meeting to populate this view." />
    </StackPanel>
</Page>
