<Page
    x:Class="MeetVault.Views.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Meetings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search meetings" Width="320" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
            <TextBlock x:Name="EmptyState" Text="No meetings yet. Start one to populate this list." Visibility="Collapsed" TextWrapping="Wrap" />
            <ListView x:Name="MeetingList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding When}" Opacity="0.7" />
                                <TextBlock Text="{Binding Duration}" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Top" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
