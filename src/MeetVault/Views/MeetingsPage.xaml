<Page
    x:Class="MeetVault.Views.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="RootScroll_SizeChanged">
        <StackPanel x:Name="ContentColumn" Padding="32,24" Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="Meetings" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search meetings" MinWidth="240" MaxWidth="420" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
                <Button Grid.Column="1" VerticalAlignment="Center" ToolTipService.ToolTip="Manage meetings"
                        AutomationProperties.Name="Manage meetings">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Delete meetings" Click="EnterSelection_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock x:Name="EmptyState" Text="No meetings yet. Start one to populate this list." Visibility="Collapsed" TextWrapping="Wrap" />
            <!-- Card container keeps the table visually distinct from the page. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12,6">
                <StackPanel>
                    <StackPanel x:Name="SelectionBar" Orientation="Horizontal" Spacing="8" Padding="12,6,12,2" Visibility="Collapsed">
                        <TextBlock x:Name="SelectionCount" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="SelectAllButton" Content="Select all visible" Click="SelectAll_Click" />
                        <Button x:Name="ClearSelectionButton" Content="Clear selection" Click="ClearSelection_Click" />
                        <Button x:Name="DeleteSelectedButton" Content="Delete selected" Click="DeleteSelected_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelSelectionButton" Content="Cancel" Click="CancelSelection_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                    <Grid Padding="12,0,12,4" ColumnSpacing="16" Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderSelectSpacer" Width="32" Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" Text="Title" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="When" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="Duration" FontSize="12" MinWidth="90" />
                        <TextBlock Grid.Column="4" Text="Status" FontSize="12" MinWidth="80" />
                    </Grid>
                    <ItemsControl x:Name="MeetingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Row button and Delete are siblings, not nested: an inner Button
                                     inside another Button never receives the click. -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OpenMeeting_Click" Background="{Binding RowBackground}" BorderThickness="0" Padding="12,10"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="4"
                                            AutomationProperties.Name="{Binding Title}"
                                            ToolTipService.ToolTip="{Binding RowTooltip}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- The checkbox is a visual indicator; the row click toggles
                                                 selection (hit testing stays on the row button). -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsSelectable}"
                                                      Visibility="{Binding CheckVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                                      MinWidth="0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Opacity="0.7" VerticalAlignment="Center" MinWidth="90" />
                                            <TextBlock Grid.Column="4" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" MinWidth="80" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Content="Delete" Click="DeleteMeeting_Click" VerticalAlignment="Center" Visibility="{Binding DeleteVisibility}"
                                            AutomationProperties.Name="Delete"
                                            AutomationProperties.HelpText="{Binding Title}"
                                            ToolTipService.ToolTip="Delete this meeting and its recording" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
