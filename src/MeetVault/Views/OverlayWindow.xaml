<Window
    x:Class="MeetVault.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetVault.Views"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="MeetVault overlay">
    <Grid x:Name="RootSurface" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="HeaderBar" Margin="12,8,140,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Live transcript" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <ListView x:Name="TranscriptList" FontSize="{x:Bind Vm.FontSize, Mode=OneWay}" SelectionMode="None" Padding="12,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TranscriptLine">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Speaker}" VerticalAlignment="Top" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No transcript lines yet." Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>



