<Window
    x:Class="MeetVault.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeetVault.Views"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Title="MeetVault overlay">
    <Grid x:Name="RootSurface" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="{x:Bind Vm.Opacity, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Live transcript" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <primitives:ToggleButton Grid.Column="1" Content="Pin" Click="Pin_Click" IsChecked="{x:Bind Vm.IsPinned, Mode=TwoWay}" ToolTipService.ToolTip="Keep the overlay above other windows" />
        </Grid>
        <Grid Grid.Row="1">
            <ListView x:Name="TranscriptList" FontSize="{x:Bind Vm.FontSize, Mode=OneWay}" SelectionMode="None" Padding="12,0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TranscriptLine">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{x:Bind Speaker}" Background="Transparent" BorderThickness="0" Padding="0" Click="Rename_Click" ToolTipService.ToolTip="Rename this speaker on every line" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Text="No transcript lines yet." Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2" Margin="12,8,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Opacity" FontSize="12" />
                <Slider Minimum="0.3" Maximum="1" StepFrequency="0.05" Value="{x:Bind Vm.Opacity, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Font size" FontSize="12" />
                <NumberBox Minimum="10" Maximum="48" SmallChange="1" SpinButtonPlacementMode="Inline" Value="{x:Bind Vm.FontSize, Mode=TwoWay}" Width="96" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Lines" FontSize="12" />
                <NumberBox Minimum="1" Maximum="500" SmallChange="5" SpinButtonPlacementMode="Inline" Value="{x:Bind Vm.LineCount, Mode=TwoWay}" Width="96" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>



