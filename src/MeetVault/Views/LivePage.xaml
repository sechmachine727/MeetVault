<Page
    x:Class="MeetVault.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Live transcript" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <ListView x:Name="TranscriptList" MinHeight="300" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Speaker}" Click="Speaker_Click" Style="{StaticResource TextBlockButtonStyle}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="PartialLine" Opacity="0.6" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Pause" Click="Pause_Click" />
                <Button Content="Show overlay" Click="Overlay_Click" />
                <Button Content="Stop" Click="Stop_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Speakers" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="SpeakerList" SelectionMode="None" />
            <TextBlock Text="Audio sources" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="AudioStatus" Text="Mic: not started. App source: not picked." />
            <TextBlock Text="Engine status" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EngineStatus" Text="Engines ship in P4; session state machine is ready (Core)." />
        </StackPanel>
    </Grid>
</Page>
