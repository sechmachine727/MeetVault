<Page
    x:Class="MeetVault.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Live transcript" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <!-- ItemsControl, not ListView: ListView item templates with bound buttons NRE
                 inside ComWrappers vtable computation in the trimmed portable exe. -->
            <ScrollViewer x:Name="TranscriptScroll" MaxHeight="320" VerticalScrollMode="Auto">
            <ItemsControl x:Name="TranscriptList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" VerticalAlignment="Top" MinWidth="72" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="PartialLine" Opacity="0.6" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Pause" Click="Pause_Click" /><Button Content="Resume" Click="Resume_Click" />
                <Button Content="Show overlay" Click="Overlay_Click" />
                <Button Content="Stop" Click="Stop_Click" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="Speakers" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="SpeakerEmpty" Text="Speakers appear here once the first turn is recognized." Opacity="0.7" TextWrapping="Wrap" />
            <StackPanel x:Name="SpeakerPanel" Spacing="6" />
            <TextBlock Text="Audio sources" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="AudioStatus" Text="Mic: not started. App source: not picked." TextWrapping="Wrap" />
            <TextBlock Text="Engine status" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EngineStatus" Text="Checking engines..." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

