<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MeetVault</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
  </ItemGroup>
  <!-- Unpackaged portable exe has no package identity: DeploymentManager.Initialize
       dies REGDB_E_CLASSNOTREG. The installed MSIX keeps identity and is unaffected.
       Bootstrap (DDLM) auto-init stays on so framework resolution still works. -->
  <PropertyGroup>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeetVault.Core\MeetVault.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Never trim this app: ILLink strips CsWinRT ABI vtable glue (ItemsSource NRE in
         GetAbiToProjectionVftblPtr) and the sherpa-onnx wrapper (native AV at engine init). -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- The whisper runtime packages copy natives for every RID. Keep only the Windows x64
       set so the portable and the MSIX carry no linux/macos/arm payload (~17 MB). -->
  <Target Name="TrimForeignRuntimes" AfterTargets="Build">
    <ItemGroup>
      <_ForeignRuntimeDir Include="$(OutDir)runtimes\linux-arm;$(OutDir)runtimes\linux-arm64;$(OutDir)runtimes\linux-x64;$(OutDir)runtimes\macos-arm64;$(OutDir)runtimes\macos-x64;$(OutDir)runtimes\win-arm64;$(OutDir)runtimes\win-x86;$(OutDir)runtimes\vulkan\linux-x64" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntimeDir)" />
    <Delete Files="$(OutDir)ggml-metal.metal" ContinueOnError="true" />
  </Target>
  <Target Name="TrimForeignRuntimesPublish" AfterTargets="Publish">
    <ItemGroup>
      <_ForeignPublishDir Include="$(PublishDir)runtimes\linux-arm;$(PublishDir)runtimes\linux-arm64;$(PublishDir)runtimes\linux-x64;$(PublishDir)runtimes\macos-arm64;$(PublishDir)runtimes\macos-x64;$(PublishDir)runtimes\win-arm64;$(PublishDir)runtimes\win-x86;$(PublishDir)runtimes\vulkan\linux-x64" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignPublishDir)" />
    <Delete Files="$(PublishDir)ggml-metal.metal" ContinueOnError="true" />
  </Target>

  <PropertyGroup>
    <!-- Repo root, for the staged third-party payloads below. -->
    <VaultRepoRoot>$(MSBuildThisFileDirectory)..\..\</VaultRepoRoot>
  </PropertyGroup>

  <!-- Staged third-party payloads, not committed (see AGENTS.md). Content items rather than a
       post-build Copy so publish and the MSIX packaging both track them, and so a plain build
       does not also write a copy into bin\...\publish (the SDK always defines PublishDir).
       Every destination below is a directory a native DLL is loaded from: the loader searches
       the loaded DLL's own directory, not the app directory, because .NET uses
       LOAD_WITH_ALTERED_SEARCH_PATH. The condition keeps the x64 binaries out of the x86 and
       arm64 outputs. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <!-- NVIDIA CUDA user-mode runtime (CUDA Toolkit EULA, Attachment A), for the CUDA backend. -->
    <Content Include="$(VaultRepoRoot)cuda\win-x64\*.dll">
      <Link>runtimes\cuda\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- whisper.net decides whether CUDA is usable by loading cudart64_13 by bare name
         (CudaHelper.IsCudaAvailable -> NativeLibrary.TryLoad), which searches the exe's own
         directory, System32 and PATH, not runtimes\cuda\win-x64. Without this copy the probe
         fails on any machine with no CUDA 13 toolkit on PATH and CUDA silently falls back to
         CPU however good the GPU is. -->
    <Content Include="$(VaultRepoRoot)cuda\win-x64\cudart64_13.dll" Condition="Exists('$(VaultRepoRoot)cuda\win-x64\cudart64_13.dll')">
      <Link>cudart64_13.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The MSVC/OpenMP runtime the whisper natives link against. Without it whisper fails to
         load on a machine with no VC++ redistributable, on CPU as well as GPU. -->
    <Content Include="$(VaultRepoRoot)vcruntime\win-x64\*.dll">
      <Link>runtimes\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(VaultRepoRoot)vcruntime\win-x64\*.dll">
      <Link>runtimes\cuda\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(VaultRepoRoot)vcruntime\win-x64\*.dll">
      <Link>runtimes\vulkan\win-x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Redistribution notice, shipped with the package that carries the third-party binaries. -->
    <Content Include="$(VaultRepoRoot)docs\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
