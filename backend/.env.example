MVB_ENV=prod
MVB_PORT=8080
MVB_SESSION_TTL_DAYS=30
# Self-service sign-up on POST /v1/auth/register. Set false on a public host and use
# `python -m mvb.admin create-user` instead.
MVB_ALLOW_SIGNUP=true
# MVB_DATABASE_URL: compose sets the Postgres URL itself (service db); unset =
# the built-in SQLite default (docker run single-container mode).
MVB_MEDIA_ROOT=/data/media
MVB_MAX_UPLOAD_MB=4096
MVB_JOB_STALE_SECONDS=900
MVB_WORKER_POLL_SECONDS=2
MVB_TRANSCRIBER=mock
MVB_TRANSCRIBER_MODEL=small
MVB_DIARIZER=mock
MVB_DIARIZER_MODEL=pyannote/speaker-diarization-3.1
MVB_ANALYZER=mock
MVB_ANALYZER_MODEL=
MVB_ANALYZER_TIMEOUT_S=120
MVB_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
MVB_LMSTUDIO_API_KEY=
MVB_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
MVB_OPENCODE_GO_API_KEY=
MVB_FFMPEG=ffmpeg
MVB_FFPROBE=ffprobe
MVB_LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me-too
