# MeetVault backend — Docker deployment settings.
#
#   cp docker.env.example .env
#   docker compose up -d --build
#
# Every value here can be changed and applied with `docker compose up -d` (rebuild only
# when the container image itself must change, e.g. switching on a real ASR/diarizer).
# Full guide and worked examples: docs/DOCKER.md

# ----------------------------------------------------------------- REQUIRED
# Database password for the bundled Postgres. Compose refuses to start without it.
# Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me-please

# ----------------------------------------------------------------- PROJECT
# Names this stack's volumes and network. Keep it distinct from the deployment stack in
# deploy/: two compose files sharing a project name share volumes, and `docker compose down -v`
# in one folder then deletes the other's database and recordings.
COMPOSE_PROJECT_NAME=meetvault-backend

# ----------------------------------------------------------------- NETWORKING
# Port on the HOST that serves the API and the web console. The API always listens on
# 8080 inside the container, so only the host-side number changes.
MVB_PORT=8080
MVB_ENV=prod
MVB_LOG_LEVEL=INFO

# ----------------------------------------------------------------- IMAGE / ENGINES BUILT IN
# The image ships mock engines by default (small, no torch). Turn on a real engine here
# and rebuild — `docker compose up -d --build` — when its build arg flips:
#   WITH_TRANSCRIBE=true   installs faster-whisper  (~0.2 GB, CPU)
#   WITH_DIARIZE=true      installs pyannote+torch  (~2-3 GB)
# Note: an analyzer needs no build change at all — LM Studio and OpenCode are HTTP calls.
WITH_TRANSCRIBE=false
WITH_DIARIZE=false
APP_EXTRAS=prod
IMAGE_TAG=local

# ----------------------------------------------------------------- TRANSCRIPTION (ASR)
# MVB_TRANSCRIBER: mock | faster_whisper
#   faster_whisper requires WITH_TRANSCRIBE=true above.
# MVB_TRANSCRIBER_MODEL: tiny | base | small | medium | large-v3   (used by faster_whisper)
MVB_TRANSCRIBER=mock
MVB_TRANSCRIBER_MODEL=small

# ----------------------------------------------------------------- SPEAKER TURNS (DIARIZATION)
# MVB_DIARIZER: mock | pyannote
#   pyannote requires WITH_DIARIZE=true above AND an HF token below; the model repo is
#   gated, so accept its terms on huggingface.co with the account owning that token.
# Note: meetings recorded by the current desktop client are single-speaker by design.
MVB_DIARIZER=mock
MVB_DIARIZER_MODEL=pyannote/speaker-diarization-3.1
MVB_HF_TOKEN=

# ----------------------------------------------------------------- ANALYSIS (SUMMARY / Q&A)
# MVB_ANALYZER: mock | lmstudio | opencode-go
#   lmstudio     - a local LM Studio server on this machine (needs the API key below)
#   opencode-go  - the hosted gateway (needs its own key below)
# MVB_ANALYZER_MODEL: the exact model id the server serves; empty = whatever is loaded.
# MVB_ANALYZER_TIMEOUT_S: raise it for reasoning-heavy local models — a full analyze run
#   measured 387-425 s and a single Q&A answer 24-42 s on a 27B local model, so 120 s would
#   time out and silently fall back to the mock.
MVB_ANALYZER=mock
MVB_ANALYZER_MODEL=
MVB_ANALYZER_TIMEOUT_S=120

# LM Studio on THIS host: keep 127.0.0.1 in the URL? No - inside the container, "this host"
# is host.docker.internal (compose already maps it). Point MVB_LMSTUDIO_API_KEY at the key
# your LM Studio server requires (it answers 401 without one).
MVB_LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
MVB_LMSTUDIO_API_KEY=

# OpenCode Go (hosted). The key is billed against your plan.
MVB_OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
MVB_OPENCODE_GO_API_KEY=

# ----------------------------------------------------------------- LIMITS / BEHAVIOUR
MVB_MAX_UPLOAD_MB=4096
MVB_JOB_STALE_SECONDS=900
MVB_WORKER_POLL_SECONDS=2
MVB_WORKER_CONCURRENCY=1
MVB_SESSION_TTL_DAYS=30
# Self-service signup. Set false on a public host and create accounts with:
#   docker compose exec api python -m mvb.admin create-user --email you@example.com
MVB_ALLOW_SIGNUP=true

# ----------------------------------------------------------------- MODEL CACHE (optional)
# A real ASR/diarizer downloads weights on first use. Leave this as the local folder to
# keep them between runs, or point it at an existing cache you already have.
HF_CACHE_DIR=./.docker-hf
