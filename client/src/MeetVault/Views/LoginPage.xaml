<Page
    x:Class="MeetVault.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Horizontal scrolling is disabled so the panel can centre in the viewport (a ScrollViewer
         otherwise measures its content with infinite width); SettingsPage centres the same way.
         The panel is a fixed-width card: MaxWidth caps it while Stretch centres the capped width,
         so the signed-in and signed-out states share one width. VerticalAlignment is stated too —
         without it the panel stretches to the full viewport height. -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Center">
        <Grid Padding="24">
            <Border x:Name="AccountPanel" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    MaxWidth="560" Padding="24" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="AccTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />

                    <StackPanel x:Name="SignedOutPanel" Spacing="8">
                        <TextBlock x:Uid="AccIntro" Opacity="0.7" TextWrapping="Wrap" />
                        <TextBlock x:Uid="AccEmailLabel" FontWeight="SemiBold" />
                        <TextBox x:Name="EmailBox" x:Uid="AccEmailBox" />
                        <TextBlock x:Uid="AccPasswordLabel" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordBox" x:Uid="AccPasswordBox" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="SignInButton" x:Uid="AccSignIn" Style="{StaticResource AccentButtonStyle}" Click="SignIn_Click" />
                            <ProgressRing x:Name="SignInRing" IsActive="False" Width="24" Height="24" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SignedInPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Uid="AccSignedInLabel" FontWeight="SemiBold" />
                        <TextBlock x:Name="AccountText" TextWrapping="Wrap" />
                        <TextBlock x:Name="ExpiryText" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Name="SignOutButton" x:Uid="AccSignOut" Click="SignOut_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
