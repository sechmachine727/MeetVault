<Page
    x:Class="MeetVault.Views.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MeetVault.Views">
    <Page.Resources>
        <views:StatusBrushConverter x:Key="StatusBrushConverter" />
    </Page.Resources>
    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="RootScroll_SizeChanged">
        <StackPanel x:Name="ContentColumn" Padding="32,24" Spacing="16" HorizontalAlignment="Center">
            <TextBlock x:Uid="MtgTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" x:Uid="MtgSearch" MinWidth="320" MaxWidth="480" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
                <Button x:Uid="Manage" Grid.Column="1" VerticalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="DeleteMeetings" Click="EnterSelection_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
            </Grid>
            <TextBlock x:Name="EmptyState" Text="No meetings yet. Start one to populate this list." Visibility="Collapsed" TextWrapping="Wrap" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <StackPanel>
                    <StackPanel x:Name="SelectionBar" Orientation="Horizontal" Spacing="8" Padding="8,4,8,8" Visibility="Collapsed">
                        <TextBlock x:Name="HeaderSelectSpacer" Width="32" Visibility="Collapsed" />
                        <TextBlock x:Name="SelectionCount" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="SelectAllButton" x:Uid="SelAll" Click="SelectAll_Click">
                            <FontIcon Glyph="&#xE73A;" FontSize="14" />
                        </Button>
                        <Button x:Name="ClearSelectionButton" x:Uid="SelClear" Click="ClearSelection_Click">
                            <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                        </Button>
                        <Button x:Name="DeleteSelectedButton" x:Uid="SelDelete" Click="DeleteSelected_Click" IsEnabled="False"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                        <Button x:Name="CancelSelectionButton" x:Uid="SelCancel" Click="CancelSelection_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape" />
                            </Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <ItemsControl x:Name="MeetingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Row button and Delete are siblings, not nested: an inner Button
                                     inside another Button never receives the click. -->
                                <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="OpenMeeting_Click" Background="{Binding RowBackground}" BorderThickness="0" Padding="10,8"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="6"
                                            AutomationProperties.Name="{Binding Title}"
                                            AutomationProperties.ItemStatus="{Binding SelectionStatus}"
                                            ToolTipService.ToolTip="{Binding RowTooltip}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- The checkbox is a visual indicator; the row click toggles
                                                 selection (hit testing stays on the row button). -->
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsSelectable}"
                                                      Visibility="{Binding CheckVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      MinWidth="0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding CreatedAt}" Opacity="0.6" FontSize="12" />
                                                    <TextBlock Text="&#x00B7;" Opacity="0.6" FontSize="12" />
                                                    <TextBlock Text="{Binding Duration}" Opacity="0.6" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="10,3"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                    <Button x:Uid="MtgRowDel" Grid.Column="1" Click="DeleteMeeting_Click" VerticalAlignment="Center" Visibility="{Binding DeleteVisibility}"
                                            Width="40" Padding="0"
                                            AutomationProperties.HelpText="{Binding Title}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
