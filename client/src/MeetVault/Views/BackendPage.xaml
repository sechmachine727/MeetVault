<Page
    x:Class="MeetVault.Views.BackendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="RootScroll_SizeChanged">
        <!-- The list fills the page: the content column's width is set from the viewport in
             RootScroll_SizeChanged, because inside a ScrollViewer neither Center nor Stretch
             makes a StackPanel span the pane (measured: it shrink-to-fits its content). -->
        <StackPanel x:Name="ContentColumn" Padding="24" Spacing="12" HorizontalAlignment="Left">
            <TextBlock x:Uid="BackPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational">
                <InfoBar.ActionButton>
                    <Button x:Name="SignInActionButton" x:Uid="Cloud.SignInButton" Click="SignIn_Click" Visibility="Collapsed" />
                </InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" x:Uid="BackPageRefresh" Click="Refresh_Click" />
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <TextBlock x:Name="EmptyState" x:Uid="Cloud.Empty" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
            <ItemsControl x:Name="MeetingsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16" Margin="0,0,0,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Meta}" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusLine}" Opacity="0.8" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding OpenLabel}"
                                        AutomationProperties.Name="{Binding OpenAutomation}"
                                        Click="Open_Click" Tag="{Binding}" />
                                <Button Grid.Column="2" Content="{Binding RemoveLabel}"
                                        AutomationProperties.Name="{Binding RemoveAutomation}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Click="Remove_Click" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
