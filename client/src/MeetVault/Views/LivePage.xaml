<Page
    x:Class="MeetVault.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock x:Uid="LiveTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <!-- ItemsControl, not ListView: ListView item templates with bound buttons NRE
                 inside ComWrappers vtable computation in the trimmed portable exe. -->
            <ScrollViewer x:Name="TranscriptScroll" MaxHeight="320" VerticalScrollMode="Auto">
            <StackPanel>
            <ItemsControl x:Name="TranscriptList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Single-speaker pipeline: no name column; the 8px left inset is kept for visual parity. -->
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="8,0,0,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The open sentence's interim text: a trailing element, never a row of the
                 bound collection (the ctor re-snapshots on every collection change). -->
            <TextBlock x:Name="PartialLine" TextWrapping="Wrap" Margin="8,0,0,0"
                       Opacity="0.85" Visibility="Collapsed" />
            </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" x:Uid="LiveStart" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="PauseButton" x:Uid="LivePause" Click="Pause_Click" IsEnabled="False" />
                <Button x:Name="ResumeButton" x:Uid="LiveResume" Click="Resume_Click" IsEnabled="False" />
                <Button x:Name="OverlayButton" x:Uid="LiveOverlay" Click="Overlay_Click" />
                <Button x:Name="StopButton" x:Uid="LiveStop" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock x:Uid="LiveAudioLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="AudioStatus" Text="Mic: not started." TextWrapping="Wrap" />
            <TextBlock x:Uid="LiveEngineLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EngineStatus" Text="Checking engines..." TextWrapping="Wrap" />
            <TextBlock x:Uid="LiveLanguageLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ComboBox x:Name="LanguageCombo" x:Uid="LiveLanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="LanguageCombo_SelectionChanged" />
            <TextBlock x:Name="LangStatus" Text="" TextWrapping="Wrap" />
            <TextBlock x:Uid="LiveScreenLabel" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="ScreenToggle" x:Uid="LiveScreenRecord" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ScreenSourceCombo" x:Uid="LiveScreenSourceCombo" HorizontalAlignment="Stretch" SelectionChanged="ScreenSource_Changed" />
                <Button Grid.Column="1" x:Uid="LiveScreenRefresh" Click="ScreenRefresh_Click" />
            </Grid>
            <Button x:Name="ScreenRunButton" x:Uid="LiveScreenStart" Click="ScreenRun_Click" IsEnabled="False" />
            <Border x:Name="PreviewBox" Visibility="Collapsed" MaxHeight="160" CornerRadius="4">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="ScreenStatus" Text="" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>

