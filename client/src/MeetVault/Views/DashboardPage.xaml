<Page
    x:Class="MeetVault.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="RootScroll_SizeChanged">
        <StackPanel x:Name="ContentColumn" Padding="32,24" Spacing="16" HorizontalAlignment="Center">
            <!-- Greeting on the left, the primary action top-right where it stays reachable. -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingTitle" x:Uid="DashGreeting" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelStatus" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Uid="DashStart" Grid.Column="1" Click="Start_Click" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="RecoveryBar" x:Uid="DashRecovery" IsOpen="False" Severity="Warning" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Uid="DashResume" Click="Resume_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="220">
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock x:Uid="DashMicLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="MicStatus" Text="Not started" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,24,12">
                    <TextBlock x:Uid="DashEngineLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineStatus" Text="Checking..." Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </VariableSizedWrapGrid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DashRecent" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Uid="Manage" Grid.Column="1" VerticalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="DeleteMeetings" Click="EnterSelection_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
            </Grid>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <StackPanel>
                    <StackPanel x:Name="SelectionBar" Orientation="Horizontal" Spacing="8" Padding="8,4,8,8" Visibility="Collapsed">
                        <TextBlock x:Name="HeaderSelectSpacer" Width="32" Visibility="Collapsed" />
                        <TextBlock x:Name="SelectionCount" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="SelectAllButton" x:Uid="SelAll" Click="SelectAll_Click">
                            <FontIcon Glyph="&#xE73A;" FontSize="14" />
                        </Button>
                        <Button x:Name="ClearSelectionButton" x:Uid="SelClear" Click="ClearSelection_Click">
                            <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                        </Button>
                        <Button x:Name="DeleteSelectedButton" x:Uid="SelDelete" Click="DeleteSelected_Click" IsEnabled="False"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                        <Button x:Name="CancelSelectionButton" x:Uid="SelCancel" Click="CancelSelection_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <ItemsControl x:Name="RecentMeetings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- The checkbox is a visual indicator; the row click toggles
                                     selection (hit testing stays on the row button). -->
                                <Grid Margin="0,0,0,6">
                                    <Button Click="OpenMeeting_Click" Background="{Binding RowBackground}" BorderThickness="0" Padding="14,12"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="6"
                                            AutomationProperties.Name="{Binding Title}"
                                            AutomationProperties.ItemStatus="{Binding SelectionStatus}"
                                            ToolTipService.ToolTip="{Binding RowTooltip}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" IsEnabled="{Binding IsSelectable}"
                                                      Visibility="{Binding CheckVisibility}" IsHitTestVisible="False" IsTabStop="False"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      MinWidth="0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding CreatedAt}" Opacity="0.6" FontSize="12" />
                                                    <TextBlock Text="&#x00B7;" Opacity="0.6" FontSize="12" />
                                                    <TextBlock Text="{Binding Duration}" Opacity="0.6" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="10,3"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.85" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="EmptyState" Spacing="8" Margin="12,16" Visibility="Collapsed" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock x:Uid="DashEmptyTitle" FontWeight="SemiBold" />
                        <TextBlock x:Uid="DashEmptyBody" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
