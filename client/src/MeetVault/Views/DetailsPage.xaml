<Page
    x:Class="MeetVault.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="DetTitle" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" Severity="Informational" />

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="MeetingTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="No meeting selected" />
                <TextBlock x:Name="MeetingMeta" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <MediaPlayerElement x:Name="Player" Grid.Row="3" AreTransportControlsEnabled="True" MaxHeight="220"
                            Visibility="Collapsed" />

        <MediaPlayerElement x:Name="VideoPlayer" Grid.Row="4" AreTransportControlsEnabled="False" MaxHeight="300"
                            Visibility="Collapsed" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CopyButton" x:Uid="DetCopy" Click="Copy_Click" />
            <Button x:Name="ExportButton" x:Uid="DetExport" Click="Export_Click" />
            <Button x:Name="SendButton" x:Uid="DetSend" Click="Gemini_Click" />
        </StackPanel>

        <Expander x:Name="GeminiExpander" x:Uid="DetGeminiHeader" Grid.Row="6" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock x:Name="JobState" Text="No job sent yet." TextWrapping="Wrap" />
                <TextBlock x:Name="JobResult" Text="" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </Expander>

        <Expander x:Name="BackendExpander" x:Uid="DetBackendHeader" Grid.Row="7" IsExpanded="False" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock x:Name="BackendState" Text="" TextWrapping="Wrap" />
                <ProgressBar x:Name="BackendProgress" Visibility="Collapsed" Minimum="0" Maximum="100" />
                <TextBlock x:Name="BackendSteps" Text="" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BackendSendButton" x:Uid="DetBackendSend" Click="BackendSend_Click" />
                    <Button x:Name="BackendCancelButton" x:Uid="DetBackendCancel" Click="BackendCancel_Click" Visibility="Collapsed" />
                    <Button x:Name="BackendOpenButton" x:Uid="DetBackendOpen" Click="BackendOpen_Click" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <Border Grid.Row="8" Margin="0,8,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="DetTranscript" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LineStatus" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
                </Grid>
                <Grid Grid.Row="1">
                    <ItemsControl x:Name="TranscriptList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}" CornerRadius="4" Tapped="Row_Tapped">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Uid="DetSpeakerName" Width="160" HorizontalAlignment="Stretch"
                                                  Loaded="SpeakerPicker_Loaded"
                                                  SelectionChanged="SpeakerPicker_SelectionChanged" />
                                        <TextBox x:Uid="DetLineName" Grid.Column="1"
                                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="LineText_TextChanged"
                                                 TextWrapping="Wrap" AcceptsReturn="False" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyState" x:Uid="DetEmpty"
                               Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                               MaxWidth="320" TextAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
