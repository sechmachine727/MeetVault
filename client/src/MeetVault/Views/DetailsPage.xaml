<Page
    x:Class="MeetVault.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="RootScroll_SizeChanged">
        <Grid x:Name="PageGrid" Padding="24" MaxWidth="1200" HorizontalAlignment="Stretch" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="LeftRegion" Grid.Column="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LeftStack" Spacing="12">
                    <TextBlock x:Uid="DetTitle" Style="{StaticResource TitleTextBlockStyle}" />

                    <InfoBar x:Name="StatusBar" IsOpen="False" Severity="Informational" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="MeetingTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="No meeting selected" />
                            <TextBlock x:Name="MeetingMeta" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="False"
                                                Stretch="Uniform" Visibility="Collapsed" />
                            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False"
                                                MaxHeight="220" Visibility="Collapsed" />
                            <Grid x:Name="TransportBar" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayPauseButton" x:Uid="DetPlayPause" Click="PlayPause_Click" MinWidth="48" />
                                <TextBlock x:Name="PositionText" Grid.Column="1" VerticalAlignment="Center" Width="96" />
                                <Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="1000"
                                        ValueChanged="PositionSlider_ValueChanged"
                                        PointerPressed="PositionSlider_PointerPressed"
                                        PointerReleased="PositionSlider_PointerReleased" />
                                <TextBlock x:Name="DurationText" Grid.Column="3" VerticalAlignment="Center" Width="96" />
                                <Slider x:Name="VolumeSlider" Grid.Column="4" Width="120" Minimum="0" Maximum="100"
                                        Value="100" ValueChanged="VolumeSlider_ValueChanged" x:Uid="DetVolume" />
                                <Button x:Name="FullscreenButton" Grid.Column="5" x:Uid="DetFullscreen" Click="Fullscreen_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TranscriptCard" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <ScrollViewer x:Name="TranscriptScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="TranscriptContent" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="DetTranscript" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="LineStatus" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="CopyButton" x:Uid="DetCopy" Grid.Column="2" Click="Copy_Click" />
                                    <Button x:Name="ExportButton" x:Uid="DetExport" Grid.Column="3" Click="Export_Click" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="TranscriptSource" Opacity="0.7" />
                                        <ItemsControl x:Name="LocalTranscriptList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RowBackground}" CornerRadius="4" Tapped="Row_Tapped">
                                                        <Grid Padding="0,6" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox x:Uid="DetSpeakerName" Width="160" HorizontalAlignment="Stretch"
                                                                      Loaded="SpeakerPicker_Loaded"
                                                                      SelectionChanged="SpeakerPicker_SelectionChanged" />
                                                            <TextBox x:Uid="DetLineName" Grid.Column="1"
                                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextChanged="LineText_TextChanged"
                                                                     TextWrapping="Wrap" AcceptsReturn="False" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl x:Name="CloudTranscriptList" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="4" Tapped="CloudRow_Tapped">
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="{Binding Time}" Width="80" Opacity="0.7" VerticalAlignment="Top" />
                                                            <TextBlock Text="{Binding Speaker}" Width="140" FontWeight="SemiBold" VerticalAlignment="Top" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="700" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock x:Name="EmptyState" x:Uid="DetEmpty"
                                               Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               MaxWidth="320" TextAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="AnalyzeCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="DetAnalyzeHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="AnalyzeStateText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DetAnalyzeExplain" Opacity="0.7" TextWrapping="Wrap" />
                            <ProgressBar x:Name="AnalyzeProgress" Visibility="Collapsed" Minimum="0" Maximum="100" />
                            <TextBlock x:Name="AnalyzeStepsText" Opacity="0.7" TextWrapping="Wrap" />
                            <TextBlock x:Name="AnalyzeMockBadge" Opacity="0.8" FontStyle="Italic" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AnalyzeButton" x:Uid="DetAnalyze" Click="Analyze_Click" />
                                <Button x:Name="AnalyzeCancelButton" x:Uid="DetAnalyzeCancel" Click="AnalyzeCancel_Click" Visibility="Collapsed" />
                                <Button x:Name="AnalyzeForgetButton" x:Uid="DetAnalyzeForget" Click="AnalyzeForget_Click" Visibility="Collapsed" />
                                <Button x:Name="AnalyzeSignInButton" x:Uid="DetAnalyzeSignInButton" Click="AnalyzeSignIn_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SummaryCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="DetSummaryHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="SummaryStateText" TextWrapping="Wrap" Opacity="0.8" />
                            <StackPanel x:Name="SummaryContent" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="SummaryOverviewText" TextWrapping="Wrap" />
                                <ItemsControl x:Name="SummaryBullets">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="DetDiscussionsHeader" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl x:Name="AgendaList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="DetDecisionsHeader" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl x:Name="DecisionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4" Tapped="CitationRow_Tapped">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Opacity="0.7" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="DetActionsHeader" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl x:Name="ActionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4" Tapped="CitationRow_Tapped">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" Opacity="0.7" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Uid="DetQaHeader" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <ItemsControl x:Name="QaList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4" Tapped="CitationRow_Tapped">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="QaBox" x:Uid="DetQaBox" Width="420" />
                                    <Button x:Name="AskButton" x:Uid="DetQaAsk" Click="Ask_Click" />
                                </StackPanel>
                                <TextBlock x:Name="QaStatus" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CopySummaryButton" x:Uid="DetCopySummary" Click="CopySummary_Click" />
                                <Button x:Name="ExportWordButton" x:Uid="DetExportWord" Click="ExportWord_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="RightRegion" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RightStack" Spacing="12" />
            </ScrollViewer>
        </Grid>
    </ScrollViewer>
</Page>
