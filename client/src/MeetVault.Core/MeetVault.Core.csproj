<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ScreenRecorderLib ships a C++/CLI mixed-mode assembly whose targets reject AnyCPU
         (v7.0.1); the library is x64-only on this box anyway (app ships win-x64). -->
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeetVault.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- Windows DPAPI, for the secret store that works without package identity (the portable
         zip and any classic installer): the WinRT PasswordVault needs identity and no-ops
         without it, which silently dropped the session token on every restart. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

</Project>
